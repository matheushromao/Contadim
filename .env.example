# =============================================================================
# Contadim: variáveis de ambiente
# Copie para `.env` (cp .env.example .env). O mesmo arquivo serve para a API,
# o front-end e o Docker Compose. Nunca faça commit do `.env`.
# =============================================================================

# --- Banco de dados (Docker Compose) -----------------------------------------
# Credenciais do container PostgreSQL criado por `pnpm db:up`.
POSTGRES_USER=contadim
POSTGRES_PASSWORD=contadim
POSTGRES_DB=contadim
# Porta exposta na sua máquina. Mude se a 5432 já estiver em uso.
POSTGRES_PORT=5432

# --- Docker Compose: perfil "full" (docker compose --profile full up) --------
# Portas da API e do front na sua máquina.
API_PORT=3000
WEB_PORT=8080
# Segredo JWT da API em container. Vazio = gerado aleatoriamente a cada início
# (suficiente para testar localmente). Em produção, defina um valor fixo.
FULL_JWT_ACCESS_SECRET=

# --- API ---------------------------------------------------------------------
# Ambiente: development | test | production
NODE_ENV=development
# Porta HTTP da API.
PORT=3000
# Conexão com o banco principal.
DATABASE_URL=postgresql://contadim:contadim@localhost:5432/contadim
# Banco usado pelos testes de integração (criado automaticamente pelo Docker).
DATABASE_URL_TEST=postgresql://contadim:contadim@localhost:5432/contadim_test
# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Use "true" quando a API estiver atrás de um proxy reverso (Nginx, load balancer).
TRUST_PROXY=false
# Documentação Swagger em /api/docs.
SWAGGER_ENABLED=true
# Rate limit global: no máximo RATE_LIMIT_MAX requisições por IP a cada RATE_LIMIT_TTL_SECONDS.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Limite mais rígido para cadastro e login (por IP, na mesma janela de tempo).
AUTH_RATE_LIMIT_MAX=10

# --- Autenticação ------------------------------------------------------------
# Segredo para assinar os access tokens (JWT). Gere um com: openssl rand -base64 48
# O valor abaixo só serve para desenvolvimento: a API se recusa a subir com ele em produção.
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-e-longo
# Validade do access token, em segundos (padrão: 15 minutos).
JWT_ACCESS_TTL_SECONDS=900
# Validade do refresh token (cookie httpOnly), em dias.
REFRESH_TOKEN_TTL_DAYS=30
# Cookie só via HTTPS. Padrão: true em produção, false fora dela.
# COOKIE_SECURE=true
# SameSite do cookie: "lax" quando front e API estão no mesmo domínio;
# "none" quando estão em domínios diferentes (exige COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
