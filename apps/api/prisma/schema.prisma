// Modelo de dados do Contadim.
// Regras: dinheiro sempre em centavos (Int), datas de lançamento como DATE,
// timestamps de auditoria em UTC (timestamptz) e toda entidade pertence a um usuário.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
}

enum EntryType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// Sempre em minúsculas (normalizado pela aplicação).
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  refreshTokens   RefreshToken[]
  creditCards     CreditCard[]
  invoicePayments InvoicePayment[]

  @@map("users")
}

/// Refresh tokens com rotação: cada uso gera um novo token da mesma família.
/// Reutilizar um token já trocado revoga a família inteira (indício de roubo).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 do token. O token em si nunca é armazenado.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String
  type           AccountType
  /// Saldo inicial em centavos (pode ser negativo).
  initialBalance Int         @default(0) @map("initial_balance")
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  invoicePayments InvoicePayment[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  type       EntryType
  /// Cor em hexadecimal (#RRGGBB).
  color      String
  /// Nome do ícone (Lucide), resolvido pelo front-end.
  icon       String
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, type, name])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  description  String?
  /// Valor em centavos, sempre positivo (CHECK no banco). O sinal vem de `type`.
  amount       Int
  type         EntryType
  /// Data do lançamento (sem horário).
  date         DateTime  @db.Date
  categoryId   String    @map("category_id") @db.Uuid
  /// Exatamente um entre `accountId` e `cardId` (CHECK no banco).
  accountId    String?   @map("account_id") @db.Uuid
  /// Compra no cartão de crédito (sempre despesa, sempre com grupo de parcelamento).
  cardId       String?   @map("card_id") @db.Uuid
  /// Fatura (dia 1 do mês de vencimento) em que a parcela é cobrada. Fixada na criação.
  invoiceMonth DateTime? @map("invoice_month") @db.Date

  // Preparação para as próximas fases (ainda sem endpoints).
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  installmentGroupId  String?              @map("installment_group_id") @db.Uuid
  installmentNumber   Int?                 @map("installment_number")
  installmentTotal    Int?                 @map("installment_total")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  Account?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card     CreditCard? @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, categoryId, date])
  @@index([userId, accountId, date])
  @@index([installmentGroupId])
  @@index([userId, invoiceMonth])
  @@index([userId, cardId, invoiceMonth])
  @@map("transactions")
}

model CreditCard {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  /// Limite total em centavos.
  limit      Int
  /// Dia do fechamento (1–31). Compras a partir deste dia vão para a fatura seguinte.
  closingDay Int       @map("closing_day")
  /// Dia do vencimento (1–31). Identifica a fatura pelo mês em que vence.
  dueDay     Int       @map("due_day")
  /// Cor em hexadecimal (#RRGGBB), para o "cartãozinho" na tela.
  color      String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payments     InvoicePayment[]

  @@index([userId])
  @@map("credit_cards")
}

/// Pagamento (total ou parcial) de uma fatura, saindo de uma conta.
/// Reduz o saldo da conta, mas não é despesa: as compras já contaram no resumo.
model InvoicePayment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  cardId       String   @map("card_id") @db.Uuid
  /// Fatura paga (dia 1 do mês de vencimento).
  invoiceMonth DateTime @map("invoice_month") @db.Date
  accountId    String   @map("account_id") @db.Uuid
  /// Valor em centavos, sempre positivo.
  amount       Int
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card    CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  account Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, cardId, invoiceMonth])
  @@index([accountId])
  @@map("invoice_payments")
}
